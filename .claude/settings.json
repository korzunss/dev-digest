{
  "permissions": {
    "allow": [
      "mcp__devdigest__list_agents",
      "mcp__devdigest__get_findings",
      "mcp__devdigest__get_conventions",
      "mcp__devdigest__get_blast_radius"
    ],
    "ask": [
      "mcp__devdigest__run_agent_on_pr"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-gate.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
