# @devdigest/api environment
DATABASE_URL=postgres://devdigest:devdigest@localhost:5432/devdigest

# LLM providers (BYO key — entered via Settings UI in prod; env for local dev).
# Optional: the app boots with none. A key is only needed for the provider you
# actually run a review on (or embeddings, see EMBEDDINGS_ENABLED).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# GitHub (REST via Octokit) — PAT with repo scope. Canonical name is
# GITHUB_TOKEN; GITHUB_PAT is still accepted as a fallback for back-compat.
GITHUB_TOKEN=

# GitLab (REST v4 via fetch) — PAT with scope `api`, or `read_api` +
# `write_repository` for a read-mostly setup.
GITLAB_TOKEN=
# Self-managed GitLab instances, comma-separated, so their URLs are recognised
# without passing `provider` on every add. A bare host is fine
# (git.acme.com); use a FULL base URL when GitLab is installed under a
# relative URL (https://acme.com/gitlab) — the prefix is what tells that apart
# from a top-level group literally named "gitlab".
GITLAB_HOST=
# Two instances need two PATs. Store the second under an instance-scoped key in
# ~/.devdigest/secrets.json: "GITLAB_TOKEN@git.acme.com". That form cannot come
# from the environment ('@' is not legal in a var name) — it is looked up first,
# then this plain GITLAB_TOKEN.

# --- Self-managed forge: TLS and proxy -------------------------------------
# An internal CA breaks Node and git SEPARATELY, and neither variable covers
# the other. Set both when the instance uses a private certificate.
#   NODE_EXTRA_CA_CERTS=/path/ca.pem   # Node: fetch (GitLab) + Octokit. Read at process start only.
#   GIT_SSL_CAINFO=/path/ca.pem        # git clone/fetch.
# Never NODE_TLS_REJECT_UNAUTHORIZED=0 — it disables verification process-wide,
# including the LLM provider calls.
#
# Behind an egress proxy: Node's global fetch (undici) IGNORES HTTP_PROXY by
# default, while git honours it — so the API times out while the clone works.
#   Node >= 24: NODE_USE_ENV_PROXY=1
#   Node 22:    add `undici` and setGlobalDispatcher(new EnvHttpProxyAgent())

# Memory/RAG embeddings (OpenAI text-embedding-3-small). Default OFF → the app
# makes ZERO OpenAI requests. Set true to enable memory retrieval.
EMBEDDINGS_ENABLED=false

# repo-intel facade (Tier 1: repo skeleton + callers in the review prompt).
# Default ON; set false to degrade every consumer to ripgrep-only behavior.
REPO_INTEL_ENABLED=true

API_PORT=3001
WEB_PORT=3000
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent (defaults: info, silent in test)
LOG_LEVEL=
DEVDIGEST_CLONE_DIR=./clones
