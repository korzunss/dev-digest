+describe('redactCloneUrl', () => {
+  it('removes the credentials from an https clone URL', () => {
+    const out = redactCloneUrl('https://oauth2:ghp_secret@github.com/acme/api.git');
+    expect(out).not.toContain('oauth2');
+    expect(out).not.toContain('ghp_secret');
+  });
+
+  it('returns non-https input unchanged', () => {
+    expect(redactCloneUrl('git@github.com:acme/api.git')).toBe('git@github.com:acme/api.git');
+    expect(redactCloneUrl('not a url')).toBe('not a url');
+  });
+});
