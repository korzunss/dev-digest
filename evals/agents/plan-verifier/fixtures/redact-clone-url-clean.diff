+/** Strip credentials from an https clone URL before it is logged or stored. */
+export function redactCloneUrl(url: string): string {
+  try {
+    const u = new URL(url);
+    if (u.protocol !== 'https:') return url;
+    u.username = '';
+    u.password = '';
+    return u.toString();
+  } catch {
+    return url;
+  }
+}
